<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="dev">
            <group id="debug">
                <!-- Not shown in the admin; declared so that config:set with the lock-env option accepts the path. -->
                <field id="log_old_key_decrypts" translate="label" type="select" sortOrder="15"
                       showInDefault="0" showInWebsite="0" showInStore="0" canRestore="0">
                    <label>Log Decryptions under an Old Encryption Key</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
            </group>
        </section>
    </system>
</config>
